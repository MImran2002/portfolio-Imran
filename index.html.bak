        <span class="edu-face edu-face-front">
          <img src="assets/church.png" alt="Berea College blueprint illustration">
          <span class="edu-card-label">Berea College</span>
        </span>
        <span class="edu-face edu-face-back">
          <strong>Berea College Class 26’</strong>
          <span>• Majored in Computer and Information Science and Communication.</span><span>• Studied Software Development, Data Structures, Computer Organization, Theory of Computation, Human-Centered Interaction, and AI Full-Stack Engineering.</span>
        </span>
      </span>
    </button>
    
    <button class="edu-flip-card" type="button"
            aria-pressed="false" aria-label="Flip Aspire Inst. card">
      <span class="edu-flip-inner">
        <span class="edu-face edu-face-front">
          <img src="assets/city.png" alt="Aspire Inst. blueprint illustration">
          <span class="edu-card-label">Aspire Inst.</span>
        </span>
        <span class="edu-face edu-face-back">
          <strong>Aspire Institute Class 26’</strong>
          <span>• Leadership in Business and Organization.</span><span>• Pursuing Extended Leadership Program in Research.</span><span>• Google Project Management and AI Professional Certificates.</span>
        </span>
      </span>
    </button>
    
    <button class="edu-flip-card" type="button"
            aria-pressed="false" aria-label="Flip Santa Clara Uni card">
      <span class="edu-flip-inner">
        <span class="edu-face edu-face-front">
          <img src="assets/campus.png" alt="Santa Clara Uni blueprint illustration">
          <span class="edu-card-label">Santa Clara Uni</span>
        </span>
        <span class="edu-face edu-face-back">
          <strong>Santa Clara University</strong>
          <span>• Innovate & Elevate: Silicon Valley Accelerator Program.</span><span>• Won first prize in the MAMAGURT pitch competition.</span><span>• Studied prototyping, pitching, networking, storytelling, and startup development.</span>
        </span>
      </span>
    </button>
    
  </div>
  <div class="recognition edu-awards-static">
  <strong>Awards</strong>
  <div>Berea College Full Scholarship | $297,189</div>
  <div>Anna Mae and Phyllis Shumaker Award | $1,000</div>

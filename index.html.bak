<header class="site-header">
  <a href="#intro" class="signature" data-to="intro" aria-label="Return to introduction"><span class="brand-mark">✳</span><span class="brand-type">NYAN LIN ZAW <small>DESIGN × ENGINEERING / 2026</small></span></a>
  <nav class="nav-links" aria-label="Portfolio sections">

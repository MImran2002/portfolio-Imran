    grid-template-rows: 1fr 1fr 1.2fr !important;
    gap: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: white !important;
  }

  /* AI Collective: top left */

  .sheet-experience
  .experience-card[data-detail="aicollective"] {
    grid-area: 1 / 1 / 2 / 2 !important;
  }

  /* AAUW: middle left */

  .sheet-experience
  .experience-card[data-detail="aauw"] {
    grid-area: 2 / 1 / 3 / 2 !important;
  }

  /* Snapchat: tall right */

  .sheet-experience
  .experience-card[data-detail="snapchat"] {
    grid-area: 1 / 2 / 3 / 3 !important;
  }

  /* NextGen: full width bottom */

  .sheet-experience
  .experience-card[data-detail="nextgen"] {
    grid-area: 3 / 1 / 4 / 3 !important;
  }
}

/* Remove old section heading and metadata */

.sheet-experience > .section-rule,
.sheet-experience > h2:not(.experience-side-label),
.sheet-experience > .section-subtitle,
.sheet-experience > .sheet-footer {
  display: none !important;
}

/* Orange side heading accent */

.sheet-experience .experience-side-label em {
  color: #FF791E !important;
  font-style: normal !important;
}

/* Individual bento cards */

.sheet-experience .experience-card {
  position: relative !important;
  display: flex !important;
  flex-direction: column !important;

  padding: 12px !important;
  min-width: 0 !important;
  min-height: 0 !important;
  height: 100% !important;
  overflow: hidden !important;

  border: 1px solid #253b69 !important;
  border-radius: 0 !important;

  background: white !important;
  color: #112d56 !important;

  box-shadow: none !important;
  transform: none !important;
}

.sheet-experience .experience-card:hover {
  background: #f7faff !important;
  transform: none !important;
}

.sheet-experience .experience-card:focus-visible {
  outline: 3px solid #FF791E !important;
  outline-offset: -5px !important;
  z-index: 1;
}

/* Hide old numbering */

.sheet-experience .experience-card .exp-no {
  display: none !important;
}

/* Project images */

.sheet-experience .experience-card img {
  flex: 1 1 auto !important;
  min-height: 0 !important;

  width: 100% !important;
  height: 100% !important;
  max-height: none !important;

  object-fit: contain !important;
  background: transparent !important;
  padding: 28px 12px 30px !important;
}

.sheet-experience
.experience-card[data-detail="nextgen"] img {
  width: 75% !important;
  margin: auto !important;
}

/* Project labels */

.sheet-experience .experience-card div {
  display: contents !important;
}

.sheet-experience .experience-card strong {
  position: absolute !important;
  top: 11px !important;
  left: 13px !important;

  color: #e75e08 !important;
  font: 600 12px/1.3 var(--mono) !important;
}

/* Expand button appearance */

.sheet-experience .experience-card div span {
  position: absolute !important;
  right: 10px !important;
  bottom: 10px !important;

  border: 2px solid #FF791E !important;
  padding: 7px 10px !important;

  background: white !important;
  color: #e75e08 !important;

  font: 600 12px/1 var(--mono) !important;
}

.sheet-experience .experience-card:hover div span {
  background: #FF791E !important;
  color: white !important;
}

/* Tablet */

@media (max-width: 1023px) {

  .sheet.sheet-experience {
    height: auto !important;
    min-height: 0 !important;
    padding: 22px 18px 50px !important;
  }

  .sheet-experience .experience-side-label {
    display: block !important;
    position: static !important;
    margin: 0 0 15px !important;
    font: 600 18px/1.4 var(--mono) !important;
    color: white !important;
  }

  .sheet-experience .experience-grid {
    display: grid !important;
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
    gap: 10px !important;
    margin: 0 !important;
  }

  .sheet-experience .experience-card {
    height: 250px !important;
  }
}

/* Mobile */

@media (max-width: 720px) {

  .sheet-experience .experience-grid {
    grid-template-columns: 1fr !important;
  }
}

/* === COMBINED RESEARCH BOARD PATCH START === */
.combo-hidden-section{display:none!important}

#research.combo-board-section{
  flex-basis:1160px!important;
  padding:0!important;
  overflow:hidden!important;
  background-color:#0a3678!important;
  background-image:
    linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px)!important;
  background-size:22px 22px!important
}

#research.combo-board-section>.section-rule,
#research.combo-board-section>h2,
#research.combo-board-section>.section-subtitle,
#research.combo-board-section>.sheet-footer{
  display:none!important
}

.combo-board{
  display:grid;
  grid-template-columns:40px minmax(0,1fr) 38px minmax(300px,.92fr);
  height:100%;
  min-height:760px;
  padding:8px;
  background:transparent;
  gap:0;
  color:#fff
}

.combo-side-label{
  display:flex;
  align-items:center;
  justify-content:center;
  writing-mode:vertical-rl;
  transform:rotate(180deg);
  font:600 13px/1.1 var(--mono);
  letter-spacing:.04em;
  white-space:nowrap;
  color:#fff;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.35)
}

.combo-side-label em{
  color:#ff791e;
  font-style:normal
}

.combo-left-column,
.combo-right-column{
  display:grid;
  gap:0;
  min-width:0
}

.combo-left-column{
  grid-template-rows:255px 1fr;
  border-top:1px solid rgba(255,255,255,.45);
  border-bottom:1px solid rgba(255,255,255,.45);
  border-left:1px solid rgba(255,255,255,.45)
}

.combo-right-column{
  grid-template-rows:1fr 1fr;
  border:1px solid rgba(255,255,255,.45);
  border-left:none
}

.combo-panel{
  background:#0b3271;
  border-bottom:1px solid rgba(255,255,255,.45);
  padding:14px 18px;
  min-width:0
}

.combo-panel:last-child{
  border-bottom:none
}

.combo-panel h3{
  margin:0 0 14px;
  color:#fff;
  font-size:18px;
  letter-spacing:.01em
}

.combo-publications ul{
  margin:0;
  padding:0;
  list-style:none;
  display:grid;
  gap:14px
}

.combo-publications li{
  display:grid;
  grid-template-columns:16px 1fr;
  gap:10px;
  align-items:start
}

.combo-doc{
  color:#ff791e;
  font:700 14px/1 var(--mono);
  padding-top:2px
}

.combo-publications .combo-title{
  color:#fff;
  text-decoration:underline;
  text-underline-offset:2px;
  font-size:13px;
  line-height:1.15
}

.combo-awards-wrap{
  display:grid;
  grid-template-rows:auto 1fr;
  min-height:0
}

.combo-awards-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-rows:1.18fr .82fr;
  gap:0;
  min-height:0;
  border-top:1px solid rgba(255,255,255,.45)
}

.combo-award-card{
  position:relative;
  border-right:1px solid rgba(255,255,255,.45);
  border-bottom:1px solid rgba(255,255,255,.45);
  background:#0b3271;
  color:#fff;
  padding:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:0;
  overflow:hidden;
  cursor:pointer
}

.combo-award-card:nth-child(2n){
  border-right:none
}

.combo-award-card.combo-wide{
  grid-column:1/span 2;
  min-height:245px
}

.combo-award-card.combo-small{
  min-height:168px
}

.combo-award-card img{
  max-width:100%;
  max-height:100%;
  width:100%;
  height:100%;
  object-fit:contain;
  display:block
}

.combo-placeholder{
  width:100%;
  height:100%;
  min-height:120px;
  display:grid;
  place-items:center;
  background:linear-gradient(180deg,#113c81,#09295d);
  border:1px dashed rgba(255,255,255,.35);
  text-align:center;
  padding:12px
}

.combo-placeholder b{
  display:block;
  font-size:22px;
  letter-spacing:.04em
}

.combo-placeholder small{
  display:block;
  margin-top:6px;
  color:#c9dcf4;
  font:12px var(--mono)
}

.combo-award-tag{
  position:absolute;
  right:10px;
  bottom:10px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:28px;
  height:28px;
  background:#ff791e;
  color:#fff;
  font:700 20px/1 var(--mono)
}

.combo-project-box{
  position:relative;
  background:#0b3271;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:18px;
  overflow:hidden
}

.combo-project-box+.combo-project-box{
  border-top:1px solid rgba(255,255,255,.45)
}

.combo-project-box img{
  width:100%;
  height:100%;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
  display:block
}

.combo-cta{
  position:absolute;
  right:16px;
  bottom:14px;
  border:3px solid #ff791e;
  background:#0b3271;
  color:#fff;
  padding:10px 14px;
  font:600 13px/1 var(--mono);
  cursor:pointer
}

.combo-award-card:focus-visible,
.combo-cta:focus-visible{
  outline:3px solid #fff;
  outline-offset:-3px
}

@media (max-width: 1023px){
  #research.combo-board-section{
    padding:16px!important
  }

  .combo-board{
    grid-template-columns:1fr;
    min-height:0;
    padding:0;
    gap:12px
  }

  .combo-side-label{
    writing-mode:horizontal-tb;
    transform:none;
    min-height:44px
  }

  .combo-left-column,
  .combo-right-column{
    border:1px solid rgba(255,255,255,.45)
  }

  .combo-right-column{
    border-left:1px solid rgba(255,255,255,.45)
  }
}

@media (max-width: 720px){
  .combo-awards-grid{
    grid-template-columns:1fr;
    grid-template-rows:auto
  }

  .combo-award-card.combo-wide{
    grid-column:auto;
    min-height:210px
  }

  .combo-award-card:nth-child(2n){
    border-right:1px solid rgba(255,255,255,.45)
  }
}
/* === COMBINED RESEARCH BOARD PATCH END === */
